# --- LLM (Multimodal — Vision + Text, supports Function Calling) ---
OPENAI_API_KEY=your_zhipu_api_key_here
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
OPENAI_MODEL=glm-4.6v-flash

# --- Vision LLM (deprecated: main model handles vision directly) ---
# VISION_MODEL=glm-4.6v-flash
# VISION_API_KEY=  (defaults to OPENAI_API_KEY)
# VISION_BASE_URL=  (defaults to OPENAI_BASE_URL)

# --- Embedding ---
EMBEDDING_PROVIDER=zhipu
EMBEDDING_MODEL=embedding-2
# EMBEDDING_API_KEY=  (defaults to OPENAI_API_KEY)
# EMBEDDING_BASE_URL=  (defaults to OPENAI_BASE_URL)

# --- CLIP ---
CLIP_MODEL_NAME=ViT-B/32
CLIP_DEVICE=cpu

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_data
TEXT_COLLECTION_NAME=text_collection
IMAGE_COLLECTION_NAME=image_collection

# --- Chunker ---
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=50

# --- RAG ---
RAG_TOP_K=5
RAG_TOP_M=3

# --- Image Processing ---
IMAGE_MAX_DIMENSION=512
IMAGE_SAVE_DIR=./data/images

# --- Agent (Week 4) ---
AGENT_MAX_STEPS=10
AGENT_DEFAULT_STRATEGY=basic
AGENT_SESSION_DIR=./data/sessions
SEARCH_WEB_QUERY_MAX_LENGTH=200

# --- ASR (Speech-to-Text) ---
# ASR_PROVIDER=zhipu          # "openai" or "zhipu"
# ASR_MODEL=whisper-1         # OpenAI: whisper-1; Zhipu: glm-asr-2512
# ASR_API_KEY=                # Defaults to OPENAI_API_KEY
# ASR_BASE_URL=https://api.openai.com/v1/   # Zhipu: https://open.bigmodel.cn/api/paas/v4/

# --- TTS (Text-to-Speech) ---
# TTS_PROVIDER=zhipu          # "openai" or "zhipu"
# TTS_MODEL=tts-1             # OpenAI: tts-1/tts-1-hd; Zhipu: cogtts
# TTS_VOICE=alloy             # alloy, echo, fable, nova, onyx, shimmer, ash, coral, sage
# TTS_API_KEY=                # Defaults to OPENAI_API_KEY
# TTS_BASE_URL=https://api.openai.com/v1/   # Zhipu: https://open.bigmodel.cn/api/paas/v4/

# --- Audio Limits ---
# MAX_AUDIO_SIZE_MB=10
# MAX_AUDIO_DURATION_SECONDS=120
# MAX_IMAGE_SIZE_MB=10

# --- Multimodal ---
# MULTIMODAL_MAX_HISTORY_TURNS=20
